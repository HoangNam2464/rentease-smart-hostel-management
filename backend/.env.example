# =============================================================================
# RentEase Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# For local development, you can leave most values at defaults (or skip .env).
# For production, you MUST set SECRET_KEY, DEBUG=False, ALLOWED_HOSTS, and DATABASE_URL.
# =============================================================================

# -----------------------------------------------------------------------------
# Core Django
# -----------------------------------------------------------------------------
# Generate a unique key for production:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# For PostgreSQL: DATABASE_URL=postgres://user:password@host:5432/dbname
# If not set, defaults to SQLite (backend/db.sqlite3)
# DATABASE_URL=

# -----------------------------------------------------------------------------
# Email (Gmail SMTP)
# -----------------------------------------------------------------------------
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=RentEase <your-email@gmail.com>

# -----------------------------------------------------------------------------
# Stripe (optional — for future payment integration)
# -----------------------------------------------------------------------------
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Security (production only — ignored when DEBUG=True)
# -----------------------------------------------------------------------------
# Set to False if SSL is terminated by a reverse proxy (e.g. nginx)
# SECURE_SSL_REDIRECT=True
